{
  "info": {
    "name": "CinemaHub real Booking + VNPay integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "showtimeId",
      "value": ""
    },
    {
      "key": "seatId",
      "value": "A1"
    },
    {
      "key": "email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Gateway configuration",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payment/configuration"
      }
    },
    {
      "name": "Hold actual seats",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/hold",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"showtimeId\": \"{{showtimeId}}\",\n  \"seatIds\": [\n    \"{{seatId}}\"\n  ],\n  \"customerName\": \"Payment test\",\n  \"customerEmail\": \"{{email}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set(\"bookingId\", pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Initiate VNPay",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/payment/create-vnpay-url",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set(\"transactionId\", pm.response.json().transactionId);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Read payment result",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payment/transactions/{{transactionId}}"
      }
    },
    {
      "name": "Unsigned IPN must be rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/payment/vnpay-ipn?vnp_TxnRef=invalid"
      }
    }
  ]
}